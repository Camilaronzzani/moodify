# Porta do servidor
PORT=3333

# Provider de catálogo padrão: deezer | spotify
# A Deezer não exige credencial — é o padrão para desenvolver.
MUSIC_PROVIDER=deezer

# Mercado usado nas buscas de catálogo (ISO 3166-1 alpha-2)
MUSIC_MARKET=BR

AI_PROVIDER=lexico

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Spotify (só se MUSIC_PROVIDER=spotify)
# Crie o app em https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
